// .env.local (add these to your existing file)
/**
 * Facebook Graph API Credentials
 * 
 * Get these from your Facebook App Dashboard:
 * 1. Go to https://developers.facebook.com/
 * 2. Navigate to your app > Settings > Basic
 * 3. Copy the following values:
 */

# Your Facebook App ID
FACEBOOK_APP_ID=1642228797110381

# Your Facebook App Secret (keep this private!)
# Found at: App Dashboard > Settings > Basic
FACEBOOK_APP_SECRET=secret

# Your Page Access Token
# Generated at: App Dashboard > Tools > Graph API Explorer
# Or: Page > Settings > Messenger > Access Tokens
FACEBOOK_PAGE_ACCESS_TOKEN=token

# Optional: Your Facebook Page ID (the page you want to post to)
# You can also pass this as a parameter to the tools
FACEBOOK_PAGE_ID=your_page_id_here

FACEBOOK_PAGE_ACCESS_TOKEN
