{
  "mcpServers": {
    "my-app": {
      "type": "http",
      "url": "http://localhost:3000/",
      "model": "claude-opus-4-7",
  "max_tokens": 1000,
  "messages": [
    {
      "role": "user",
      "content": "Use tools from both mcp-server-1 and mcp-server-2 to complete this task"
    }
  ],
  "mcp_servers": [
    {
      "type": "url",
      "url": "http://localhost:3000/api/mcp-stream/[transport]/mcp",
      "name": "mcp",
      "authorization_token": "TOKEN1"
    },
    {
      "type": "url",
      "url": "http://localhost:3000/api/mcp/[transport]/mcp",
      "name": "mcp-stream",
      "authorization_token": "TOKEN2"
    }
  ],
  "tools": [
    {
      "type": "mcp_toolset",
      "mcp_server_name": "mcp-server-1"
    },
    {
      "type": "mcp_toolset",
      "mcp_server_name": "mcp-server-2",
      "default_config": {
        "defer_loading": true
      }
    }
  ]
    
    }
  }
}